{
  "rules": [
    {
      "id": "@secretlint/secretlint-rule-preset-recommend"
    },
    {
      "id": "@secretlint/secretlint-rule-pattern",
      "options": {
        "patterns": [
          {
            "name": "Anthropic API key",
            "pattern": "/sk-ant-[A-Za-z0-9_\\-]{20,}/"
          },
          {
            "name": "OpenAI API key",
            "pattern": "/sk-(proj-)?[A-Za-z0-9_\\-]{32,}/"
          },
          {
            "name": "Stripe secret or restricted key",
            "pattern": "/(sk|rk)_(live|test)_[0-9a-zA-Z]{20,}/"
          },
          {
            "name": "Private key block",
            "pattern": "/-----BEGIN [A-Z ]*PRIVATE KEY-----/"
          },
          {
            "name": "JSON Web Token",
            "pattern": "/eyJ[A-Za-z0-9_\\-]{10,}\\.eyJ[A-Za-z0-9_\\-]{10,}\\./"
          },
          {
            "name": "Database connection string with inline password (non-local host)",
            "_comment": "Local development hosts are excluded — a credential pointing at localhost is not a leak. Anything pointing at a real host is.",
            "pattern": "/(postgres(ql)?|mysql|mongodb(\\+srv)?|redis|amqp):\\/\\/[^\\s:@\\/]+:[^\\s@\\/]{3,}@(?!localhost|127\\.0\\.0\\.1|0\\.0\\.0\\.0|host\\.docker\\.internal|db[:\\/]|postgres[:\\/]|redis[:\\/]|mysql[:\\/]|mongo[:\\/])/i"
          },
          {
            "name": "Generic hardcoded credential assignment",
            "pattern": "/(api[_-]?key|secret[_-]?key|access[_-]?token|auth[_-]?token|client[_-]?secret|password|passwd)\\s*[:=]\\s*[\"'][A-Za-z0-9_\\-\\/+=]{16,}[\"']/i"
          },
          {
            "name": "Temporal or internal mTLS key material",
            "pattern": "/(tls|mtls)[_-]?(client[_-]?)?key\\s*[:=]\\s*[\"'][A-Za-z0-9_\\-\\/+=]{24,}[\"']/i"
          }
        ]
      }
    }
  ]
}
