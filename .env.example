# ==============================================================================
# ROLEVIA — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Security Rule: Never commit real credentials or production secrets to Git.
# Copy this file to .env.local for local development overrides.

NODE_ENV=development
APP_PORT=3000
APP_URL=http://localhost:3000

# Central Branding Codename
NEXT_PUBLIC_APP_CODENAME=Rolevia
NEXT_PUBLIC_APP_DISPLAY_NAME="Rolevia — AI Career Operating System"

# Core Database (PostgreSQL with pgvector) - Phase 0 Baseline
DATABASE_URL=postgresql://rolevia_dev:rolevia_dev@localhost:5432/rolevia_development
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Cache & Ephemeral State (Redis) - Phase 0 Baseline
REDIS_URL=redis://localhost:6379/0

# Authentication & Session
SESSION_SECRET=development_insecure_session_secret_change_in_production_min32chars
JWT_SECRET=development_insecure_jwt_secret_change_in_production_min32chars

# AI Platform Provider (Phase 2+)
AI_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Observability
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
